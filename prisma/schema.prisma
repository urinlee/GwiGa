// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model User {
  id            String    @id @default(cuid()) @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  AdminGroups Group[]
  groupMembers GroupMember[]
  groupNotices GroupNotice[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  description String?
  limit     Int      @default(100)
  tags      String[] @default([])
  actives Active[]
  createdAt DateTime @default(now())

  adminId String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  members GroupMember[]
  notices GroupNotice[]
  groupNoticeBadges GroupNoticeBadge[]

  events Event[]
}


model GroupNotice {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  badgeId  String?
  title     String
  content   String
  preview   String   @default("") // 목록용 본문 앞 30자 (저장/수정 시 자동 갱신)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())


  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  reads GroupNoticeRead[]

  badge GroupNoticeBadge? @relation(fields: [badgeId], references: [id])

  @@unique([id, groupId])
}


model GroupNoticeBadge {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  type      String @default("default")
  backgroundColor     String? @default("#a1a1a1")
  textColor     String? @default("#ffffff")
  description String?
  createdAt DateTime @default(now())

  notices GroupNotice[]
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}


// 읽음 1건 = 1행 (이벤트 로그). 같은 멤버가 여러 번 읽으면 여러 행 → 총 조회수는 행 수(_count).
model GroupNoticeRead {
  id        String   @id @default(cuid())
  groupId   String
  memberId  String
  noticeId  String
  readAt    DateTime @default(now())

  groupNotice GroupNotice @relation(fields: [noticeId, groupId], references: [id, groupId], onDelete: Cascade)
  groupMember GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // 중복 읽음 허용(총 조회수)이라 unique 없음
  @@index([noticeId, memberId]) // 공지별 집계 + "이 멤버가 읽었나"
  @@index([memberId])
}


model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  nickname String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberActives MemberActive[]
  groupNoticeReads GroupNoticeRead[]
  recruitApplicants RecruitApplicant[]

  @@unique([groupId, userId])
  eventMembers EventMember[]
}

enum EventStatus {
  RECRUITING
  ONGOING
  CLOSED
}

model Event {
  id        String   @id @default(cuid())
  groupId   String
  status   EventStatus @default(RECRUITING)
  name      String
  description String?
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
  minMember Int?
  maxMember Int?

  actives  Active[]
  recruits Recruit[]

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([id, groupId])
  eventMembers EventMember[]
}

enum EventMemberStatus {
  CONFIRMED
  WITHDRAWN
}

model EventMember {
  id        String            @id @default(cuid())
  eventId   String
  groupId   String
  memberId  String
  status    EventMemberStatus @default(CONFIRMED)
  joinedAt  DateTime          @default(now())
  source    String?           // "recruit" | "manual" — 어떻게 들어왔는지

  event  Event       @relation(fields: [eventId, groupId], references: [id, groupId], onDelete: Cascade)
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])   // 이벤트당 1명 1행 — 중복 원천 차단
  @@index([eventId, status])
}

enum RecruitStatus {
  OPEN
  CLOSED
}

/// 이벤트 참가자 모집. 한 이벤트가 1차·추가 모집처럼 여러 번 열 수 있어 1:N이다.
/// 액티브(결제·설문)와 달리 "이 이벤트에 들어올 것인가"를 다루므로 별도 테이블이다.
model Recruit {
  id        String        @id @default(cuid())
  eventId   String        
  groupId   String
  title     String? // "1차 모집" 처럼 구분이 필요할 때
  notice    String? // 신청 시 보여줄 유의사항
  status    RecruitStatus @default(OPEN)
  startAt   DateTime?
  endAt     DateTime?
  capacity  Int? // 이번 모집의 정원. Event.maxMember와 별개로 회차별 제한
  createdAt DateTime      @default(now())

  // groupId를 FK에 함께 넣어 다른 그룹의 이벤트에 붙는 것을 DB가 막는다.
  event      Event              @relation(fields: [eventId, groupId], references: [id, groupId], onDelete: Cascade)
  applicants RecruitApplicant[]

  @@index([eventId, status]) // 지금 열린 모집 찾기
}

enum ApplicantStatus {
  APPLIED
  CANCELED
}

/// 모집 신청 1건. 취소해도 행을 지우지 않고 상태만 바꿔 이력을 남긴다.
model RecruitApplicant {
  id         String          @id @default(cuid())
  recruitId  String
  memberId   String
  status     ApplicantStatus @default(APPLIED)
  appliedAt  DateTime        @default(now())
  canceledAt DateTime?

  recruit Recruit     @relation(fields: [recruitId], references: [id], onDelete: Cascade)
  member  GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([recruitId, memberId]) // 같은 모집에 두 번 신청 방지
  @@index([recruitId, status]) // 신청자 명단
  @@index([memberId])
}

enum ActiveType {
  MANUAL
  PAYMENT
  SURVEY
}


model Active {
  id          String   @id @default(uuid())
  type        ActiveType @default(MANUAL)
  name        String
  description String?
  primaryColor       String?  @default("#F4F4F5")
  secondaryColor       String?  @default("#57565C")
  createAt    DateTime @default(now())
  startAt     DateTime?
  endAt       DateTime?

  selfServe Boolean @default(false) // true면 멤버가 직접 활성화 가능, false면 관리자가 활성화해야함


  prerequisiteId String? // prerequisite Active id
  prerequisite Active? @relation("ActiveChain", fields: [prerequisiteId, groupId], references: [id, groupId])
  nextActives  Active[] @relation("ActiveChain")

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId, groupId], references: [id, groupId])

  memberActives MemberActive[]

  //액티브 종류
  paymentModule PaymentModule?
  surveyModule  SurveyModule?

  @@unique([id, groupId])
  @@unique([id, type])
}

model MemberActive {
  id       String @id @default(cuid())
  groupId  String
  userId   String
  activeId String
  enable   Boolean
  startAt  DateTime?
  endAt    DateTime?
  completedAt DateTime?

  groupMember GroupMember @relation(fields: [groupId, userId], references: [groupId, userId])
  active      Active      @relation(fields: [activeId, groupId], references: [id, groupId])

  @@unique([groupId, userId, activeId])
}

/// 결제 모듈. type이 PAYMENT인 액티브에 붙어 금액·기한을 담는다.
/// 이 액티브를 가진 사람은 입금을 해야 액티브가 활성화된다.
model PaymentModule {
  activeId String     @unique
  type     ActiveType @default(PAYMENT)
  amount   Int
  dueAt    DateTime?
  active   Active     @relation(fields: [activeId, type], references: [id, type], onDelete: Cascade)
  @@unique([activeId, type])
}

model SurveyModule {
  activeId  String     @unique
  type      ActiveType @default(SURVEY)
  surveyUrl String
  closedAt  DateTime?
  active    Active     @relation(fields: [activeId, type], references: [id, type], onDelete: Cascade)
  @@unique([activeId, type])
}


